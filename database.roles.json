{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "wallets": {
      "$walletNumber": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "deposits": {
      ".read": "auth != null",
      "$depId": {
        ".write": "auth != null"
      }
    },
    "withdraws": {
      ".read": "auth != null",
      "$widId": {
        ".write": "auth != null"
      }
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "plans": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "history": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "user_tasks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notices": {
      ".read": true,
      ".write": "auth != null"
    },
    "slider": {
      ".read": true,
      ".write": "auth != null"
    },
    "payment_gateways": {
      ".read": true,
      ".write": "auth != null"
    },
    "social_support": {
      ".read": true,
      ".write": "auth != null"
    },
    "notifications": {
      ".read": true,
      ".write": "auth != null"
    },
    "referral_commissions": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
